{
  "name": "petticker",
  "private": true,
  "version": "0.1.0",
  "description": "桌宠股票基金监控 - PetTicker",
  "main": "apps/main/dist/index.cjs",
  "packageManager": "pnpm@11.28.5",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "skin": "python scripts/gen_skin.py",
    "test": "node --experimental-strip-types --test packages/shared/tests/*.test.ts apps/main/src/data-source/*.test.ts apps/main/src/alert/*.test.ts apps/main/src/pet/*.test.ts",
    "typecheck": "pnpm -r typecheck",
    "smoke": "node scripts/smoke.mjs"
  }
}
